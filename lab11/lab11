                    << setw(8) << current->creditHours << " | "
                    << setw(5) << current->enrollmentYear << "\n";
           
            current = current->next;
            count++;
        }
       
        if (count >= 1000) {
            outFile << "\n... (showing first 1000 records only, file too large)\n";
        }
       
        outFile.close();
        cout << "✓ Generated " << filename << " (showing first " << count << " records)" << endl;
    }
   
    // 2. Output sorted by enrollment
    void writeSortedByEnrollment(Student* head, const string& filename) {
        ofstream outFile(filename);
        if (!outFile) {
            cerr << "Error creating file: " << filename << endl;
            return;
        }
       
        writeHeader(outFile, "STUDENTS SORTED BY ENROLLMENT YEAR", 80);
       
        // Group by enrollment year
        map<int, vector<Student*>> yearGroups;
        map<int, double> yearAvgCGPA;
        map<int, int> yearCount;
       
        Student* current = head;
        int totalProcessed = 0;
        while (current && totalProcessed < 5000) { // Limit for large files
            yearGroups[current->enrollmentYear].push_back(current);
            yearAvgCGPA[current->enrollmentYear] += current->cgpa;
            yearCount[current->enrollmentYear]++;
            current = current->next;
            totalProcessed++;
        }
       
        // Calculate averages
        for (auto& pair : yearAvgCGPA) {
            pair.second /= yearCount[pair.first];
        }
       
        // Write data grouped by year
        for (const auto& yearPair : yearGroups) {
            int year = yearPair.first;
           
            outFile << "\n" << string(40, '-') << "\n";
            outFile << "ENROLLMENT YEAR: " << year
                    << " (Students: " << yearCount[year]
                    << ", Avg CGPA: " << fixed << setprecision(2)
                    << yearAvgCGPA[year] << ")\n";
            outFile << string(40, '-') << "\n";
           
            outFile << setw(8) << "ID" << " | "
                    << setw(25) << left << "Name" << right << " | "
                    << setw(5) << "Dept" << " | "
                    << setw(3) << "Sem" << " | "
                    << setw(6) << "CGPA" << " | "
                    << setw(8) << "Credits" << "\n";
           
            int studentCount = 0;
            for (Student* student : yearPair.second) {
                if (studentCount >= 100) { // Limit per year for large files
                    outFile << "... (showing first 100 only)\n";
                    break;
                }
               
                string displayName = student->name;
                if (displayName.length() > 25) {
                    displayName = displayName.substr(0, 22) + "...";
                }
               
                outFile << setw(8) << student->studentID << " | "
                        << setw(25) << left << displayName << right << " | "
                        << setw(5) << student->department << " | "
                        << setw(3) << student->semester << " | "
                        << setw(6) << fixed << setprecision(2) << student->cgpa << " | "
