            outFile << "  Lowest CGPA: " << minCGPA << "\n";
            outFile << "  Average Credit Hours: " << fixed << setprecision(1) << avgCredits << "\n\n";
           
            // Write student details grouped by semester
            map<int, vector<Student*>> semesterGroups;
            for (Student* student : students) {
                semesterGroups[student->semester].push_back(student);
            }
           
            for (const auto& semPair : semesterGroups) {
                int semester = semPair.first;
                const auto& semStudents = semPair.second;
               
                outFile << "  Semester " << semester << " (Students: " << semStudents.size() << "):\n";
                outFile << "  " << string(70, '-') << "\n";
               
                int studentCount = 0;
                for (Student* student : semStudents) {
                    if (studentCount >= 50) { // Limit per semester
                        outFile << "    ... (showing first 50 only)\n";
