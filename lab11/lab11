// ============================================================
// Student Record Structure
// ============================================================
struct Student {
    int studentID;
    string name;
    string department;
    int semester;
    double cgpa;
    int creditHours;
    int enrollmentYear;
    Student* next;
   
    // Constructor
    Student(int id, string n, string dept, int sem, double gpa,
            int credits, int year)
        : studentID(id), name(n), department(dept), semester(sem),
          cgpa(gpa), creditHours(credits), enrollmentYear(year), next(nullptr) {}
};

// ============================================================
// Linked List Class
// ============================================================
class LinkedList {
private:
    Student* head;
    int size;
   
public:
    LinkedList() : head(nullptr), size(0) {}
   
    ~LinkedList() {
        clear();
    }
   
    void insert(Student* student) {
        if (head == nullptr) {
            head = student;
        } else {
            Student* current = head;
            while (current->next != nullptr) {
                current = current->next;
            }
            current->next = student;
        }
        student->next = nullptr;
        size++;
    }
   
    void clear() {
        Student* current = head;
        while (current != nullptr) {
            Student* temp = current;
            current = current->next;
            delete temp;
        }
        head = nullptr;
        size = 0;
    }
   
    Student* getHead() const { return head; }
    int getSize() const { return size; }
   
    // Load data from file (FIXED VERSION for your generated file)
    bool loadFromFile(const string& filename) {
        ifstream inFile(filename);
        if (!inFile) {
            cerr << "Error: Cannot open file " << filename << endl;
            return false;
        }
       
        clear();
       
        int totalStudents;
        inFile >> totalStudents;
        cout << "Total students in file: " << totalStudents << endl;
       
        for (int i = 0; i < totalStudents; i++) {
            int id, sem, credits, year;
            double gpa;
            string firstName, lastName, dept;
           
            // Read data - your format: ID FirstName LastName Dept Semester CGPA Credits Year
            if (!(inFile >> id >> firstName >> lastName >> dept >> sem >> gpa >> credits >> year)) {
                cerr << "Error reading record " << i + 1 << endl;
                break;
            }
           
            // Combine first and last name
            string name = firstName + " " + lastName;
           
            // Skip invalid records silently (your generator creates valid data)
            Student* newStudent = new Student(id, name, dept, sem, gpa, credits, year);
            insert(newStudent);
           
            // Progress indicator for large files
            if (totalStudents > 100000 && (i + 1) % 100000 == 0) {
                cout << "Loaded " << (i + 1) << " records..." << endl;
            }
        }
       
        inFile.close();
        cout << "Successfully loaded " << size << " student records." << endl;
        return true;
    }
};

// ============================================================
// Sorting Algorithms with Metrics
// ============================================================
struct SortingMetrics {
    long comparisons;
    long swaps;
   
    SortingMetrics() : comparisons(0), swaps(0) {}
};

class SortingAlgorithms {
private:
    // Selection Sort for linked list
    Student* selectionSort(Student* head, bool (*compare)(Student*, Student*), SortingMetrics& metrics) {
        if (!head || !head->next) return head;
       
        Student* sortedHead = nullptr;
        Student* sortedTail = nullptr;
        Student* current = head;
       
        while (current) {
            // Find minimum node in the remaining list
            Student* minNode = current;
            Student* prevMin = nullptr;
            Student* temp = current;
            Student* prevTemp = nullptr;
           
            while (temp) {
                metrics.comparisons++;
                if (!compare(minNode, temp)) {
                    minNode = temp;
                    prevMin = prevTemp;
                }
                prevTemp = temp;
                temp = temp->next;
            }
           
            // Remove minNode from original list
            if (prevMin) {
                prevMin->next = minNode->next;
            } else {
                current = minNode->next;
            }
           
            // Add minNode to sorted list
            minNode->next = nullptr;
            if (!sortedHead) {
                sortedHead = minNode;
                sortedTail = minNode;
            } else {
                sortedTail->next = minNode;
                sortedTail = minNode;
            }
           
            metrics.swaps++;
        }
       
        return sortedHead;
    }
   
    // Merge Sort for linked list
    Student* mergeSort(Student* head, bool (*compare)(Student*, Student*), SortingMetrics& metrics) {
        if (!head || !head->next) return head;
       
        // Split the list
        Student* slow = head;
        Student* fast = head->next;
       
        while (fast && fast->next) {
            slow = slow->next;
            fast = fast->next->next;
        }
       
        Student* secondHalf = slow->next;
        slow->next = nullptr;
       
        // Recursively sort both halves
        Student* first = mergeSort(head, compare, metrics);
        Student* second = mergeSort(secondHalf, compare, metrics);
       
        // Merge the sorted halves
        return merge(first, second, compare, metrics);
    }
   
    Student* merge(Student* first, Student* second, bool (*compare)(Student*, Student*), SortingMetrics& metrics) {
        if (!first) return second;
        if (!second) return first;
       
        Student* result = nullptr;
        Student* tail = nullptr;
       
        while (first && second) {
            metrics.comparisons++;
            if (compare(first, second)) {
                if (!result) {
                    result = first;
                    tail = first;
                } else {
                    tail->next = first;
                    tail = tail->next;
                }
                first = first->next;
            } else {
                if (!result) {
                    result = second;
                    tail = second;
                } else {
                    tail->next = second;
                    tail = tail->next;
                }
                second = second->next;
            }
            metrics.swaps++;
        }
       
        if (first) tail->next = first;
        if (second) tail->next = second;
       
        return result;
    }
   
public:
    // Comparison functions for different sorting criteria
    static bool compareByCGPA(Student* a, Student* b) {
        if (a->cgpa != b->cgpa)
            return a->cgpa > b->cgpa;
        return a->creditHours > b->creditHours;
    }
   
    static bool compareByEnrollment(Student* a, Student* b) {
        if (a->enrollmentYear != b->enrollmentYear)
            return a->enrollmentYear < b->enrollmentYear;
        return a->studentID < b->studentID;
    }
   
    static bool compareByDepartmentSemester(Student* a, Student* b) {
        if (a->department != b->department)
            return a->department < b->department;
        if (a->semester != b->semester)
            return a->semester < b->semester;
        return a->cgpa > b->cgpa;
    }
   
    static bool compareByName(Student* a, Student* b) {
        return a->name < b->name;
    }
   
    static bool compareByPerformanceTier(Student* a, Student* b) {
        int tierA = getPerformanceTier(a->cgpa);
        int tierB = getPerformanceTier(b->cgpa);
       
        if (tierA != tierB)
            return tierA < tierB;
       
        return a->name < b->name;
    }
   
    static int getPerformanceTier(double cgpa) {
        if (cgpa >= 3.70) return 1;      // Elite
        else if (cgpa >= 3.30) return 2; // High Achiever
        else if (cgpa >= 3.00) return 3; // Good Standing
        else if (cgpa >= 2.50) return 4; // Satisfactory
        else return 5;                   // Needs Improvement
    }
   
    static string getTierName(int tier) {
        switch(tier) {
            case 1: return "Elite Tier (CGPA ≥ 3.70)";
            case 2: return "High Achievers (3.30 ≤ CGPA < 3.70)";
            case 3: return "Good Standing (3.00 ≤ CGPA < 3.30)";
            case 4: return "Satisfactory (2.50 ≤ CGPA < 3.00)";
            case 5: return "Needs Improvement (CGPA < 2.50)";
            default: return "Unknown Tier";
        }
    }
   
    // Public sorting interfaces
    Student* sortWithSelection(Student* head, bool (*compare)(Student*, Student*), SortingMetrics& metrics) {
        return selectionSort(head, compare, metrics);
    }
   
    Student* sortWithMerge(Student* head, bool (*compare)(Student*, Student*), SortingMetrics& metrics) {
        return mergeSort(head, compare, metrics);
    }
   
    // Create a copy of linked list for sorting
    Student* copyList(Student* head) {
        if (!head) return nullptr;
       
        Student* newHead = nullptr;
        Student* tail = nullptr;
        Student* current = head;
       
        while (current) {
            Student* newNode = new Student(*current);
            newNode->next = nullptr;
           
            if (!newHead) {
                newHead = newNode;
                tail = newNode;
            } else {
                tail->next = newNode;
                tail = newNode;
            }
           
            current = current->next;
        }
       
        return newHead;
    }
};

// ============================================================
// File Output Functions
// ============================================================
class FileOutput {
private:
    void writeHeader(ofstream& file, const string& title, int width = 60) {
        file << string(width, '=') << "\n";
        file << setw((width + title.length()) / 2) << title << "\n";
        file << string(width, '=') << "\n\n";
    }
   
public:
    // 1. Output ranked by CGPA
    void writeRankedByCGPA(Student* head, const string& filename) {
        ofstream outFile(filename);
        if (!outFile) {
            cerr << "Error creating file: " << filename << endl;
            return;
        }
       
        writeHeader(outFile, "STUDENTS RANKED BY CGPA", 85);
       
        outFile << setw(5) << "Rank" << " | "
                << setw(8) << "ID" << " | "
                << setw(25) << left << "Name" << right << " | "
                << setw(5) << "Dept" << " | "
                << setw(3) << "Sem" << " | "
                << setw(6) << "CGPA" << " | "
                << setw(8) << "Credits" << " | "
                << setw(5) << "Year" << "\n";
       
        outFile << string(85, '-') << "\n";
       
        int rank = 1;
        Student* current = head;
        int count = 0;
        while (current && count < 1000) { // Show first 1000 for large files
            string displayName = current->name;
            if (displayName.length() > 25) {
                displayName = displayName.substr(0, 22) + "...";
            }
           
            outFile << setw(5) << rank++ << " | "
                    << setw(8) << current->studentID << " | "
                    << setw(25) << left << displayName << right << " | "
                    << setw(5) << current->department << " | "
                    << setw(3) << current->semester << " | "
