    // Search functionality
    void searchStudent(Student* head, int studentID, const string& filename) {
        ofstream outFile(filename, ios::app);
        if (!outFile) {
            cerr << "Error opening file: " << filename << endl;
            return;
        }
       
        Student* current = head;
        while (current) {
            if (current->studentID == studentID) {
                outFile << "\n" << string(40, '=') << "\n";
                outFile << "SEARCH RESULT\n";
                outFile << string(40, '=') << "\n";
                outFile << "Student ID: " << current->studentID << "\n";
                outFile << "Name: " << current->name << "\n";
                outFile << "Department: " << current->department << "\n";
                outFile << "Semester: " << current->semester << "\n";
                outFile << "CGPA: " << fixed << setprecision(2) << current->cgpa << "\n";
                outFile << "Credit Hours: " << current->creditHours << "\n";
                outFile << "Enrollment Year: " << current->enrollmentYear << "\n";
                outFile << "Performance Tier: " << SortingAlgorithms::getTierName(
                    SortingAlgorithms::getPerformanceTier(current->cgpa)) << "\n";
                outFile << string(40, '=') << "\n";
                outFile.close();
                cout << "✓ Search result appended to " << filename << endl;
                return;
            }
            current = current->next;
        }
       
        outFile << "\nStudent with ID " << studentID << " not found.\n";
        outFile.close();
        cout << "✗ Student not found. Search logged in " << filename << endl;
    }
   
    // Data validation report
    void writeDataValidation(Student* head, const string& filename) {
        ofstream outFile(filename);
        if (!outFile) {
            cerr << "Error creating file: " << filename << endl;
            return;
        }
       
        writeHeader(outFile, "DATA VALIDATION REPORT", 60);
       
        Student* current = head;
        int issueCount = 0;
        int checkedCount = 0;
       
        while (current && checkedCount < 10000) { // Check first 10000 records
            bool hasIssue = false;
            string issues;
           
            // Check CGPA range
            if (current->cgpa < 0.0 || current->cgpa > 4.0) {
                issues += "Invalid CGPA (" + to_string(current->cgpa) + "), ";
                hasIssue = true;
            }
           
            // Check semester range
            if (current->semester < 1 || current->semester > 8) {
                issues += "Invalid semester (" + to_string(current->semester) + "), ";
                hasIssue = true;
            }
           
            // Check enrollment year (reasonable range)
            if (current->enrollmentYear < 2000 || current->enrollmentYear > 2024) {
                issues += "Unusual enrollment year (" + to_string(current->enrollmentYear) + "), ";
                hasIssue = true;
            }
           
            if (hasIssue) {
                issueCount++;
                outFile << "Student ID: " << current->studentID << "\n";
                outFile << "Name: " << current->name << "\n";
                outFile << "Issues: " << issues << "\n";
                outFile << "---\n";
            }
           
            current = current->next;
            checkedCount++;
        }
       
        outFile << "\nTotal issues found in " << checkedCount << " checked records: " << issueCount << "\n";
        outFile.close();
       
        if (issueCount > 0) {
            cout << "⚠ Data validation issues found. See " << filename << endl;
        } else {
            cout << "✓ No data validation issues found in " << checkedCount << " checked records." << endl;
        }
    }
   
    // Duplicate detection report
    void writeDuplicateReport(Student* head, const string& filename) {
        ofstream outFile(filename);
        if (!outFile) {
            cerr << "Error creating file: " << filename << endl;
            return;
        }
       
        writeHeader(outFile, "DUPLICATE STUDENT ID REPORT", 60);
       
        set<int> seenIDs;
        set<int> duplicateIDs;
       
        Student* current = head;
        int checkedCount = 0;
       
        while (current && checkedCount < 10000) { // Check first 10000 records
            if (seenIDs.find(current->studentID) != seenIDs.end()) {
                duplicateIDs.insert(current->studentID);
            } else {
                seenIDs.insert(current->studentID);
            }
            current = current->next;
            checkedCount++;
        }
       
        if (duplicateIDs.empty()) {
            outFile << "No duplicate student IDs found in " << checkedCount << " checked records.\n";
            cout << "✓ No duplicate student IDs found in " << checkedCount << " checked records." << endl;
        } else {
            outFile << "Found " << duplicateIDs.size() << " duplicate student ID(s) in "
                   << checkedCount << " checked records:\n\n";
            for (int id : duplicateIDs) {
                outFile << "  Student ID: " << id << "\n";
            }
            cout << "⚠ Found " << duplicateIDs.size() << " duplicate student IDs in "
                 << checkedCount << " checked records. See " << filename << endl;
        }
       
        outFile.close();
    }
};

// ============================================================
// Main Analysis System
// ============================================================
class AnalysisSystem {
private:
    LinkedList& list;
    SortingAlgorithms sorter;
    FileOutput fileOutput;
   
    void deleteList(Student* head) {
        while (head) {
            Student* temp = head;
            head = head->next;
            delete temp;
        }
    }
   
public:
    AnalysisSystem(LinkedList& l) : list(l) {}
   
    // Generate all required reports
    void generateAllReports() {
        cout << "\n========================================" << endl;
        cout << "    GENERATING ALL ANALYSIS REPORTS" << endl;
        cout << "========================================" << endl;
       
        // Get original data
        Student* originalHead = list.getHead();
        int totalStudents = list.getSize();
       
        cout << "Processing " << totalStudents << " student records..." << endl;
       
        // For very large files, use sample data
        Student* sampleHead = originalHead;
        int sampleSize = totalStudents;
       
        if (totalStudents > 10000) {
            cout << "Note: Large dataset detected. Using first 5000 records for analysis to save time.\n";
            sampleSize = 5000;
            // Create a sample of first 5000 records
            sampleHead = nullptr;
            Student* tail = nullptr;
            Student* current = originalHead;
            for (int i = 0; i < sampleSize && current; i++) {
                Student* newNode = new Student(*current);
                newNode->next = nullptr;
                if (!sampleHead) {
                    sampleHead = newNode;
                    tail = newNode;
                } else {
                    tail->next = newNode;
                    tail = newNode;
                }
                current = current->next;
            }
        }
       
        // Track sorting metrics
        SortingMetrics selectionMetrics, mergeMetrics1, mergeMetrics2;
       
        // 1. Rank by CGPA (using Selection Sort)
        cout << "\n1. Ranking students by CGPA (Selection Sort)..." << endl;
        Student* cgpaSorted = sorter.copyList(sampleHead);
        cgpaSorted = sorter.sortWithSelection(cgpaSorted,
                                             SortingAlgorithms::compareByCGPA,
                                             selectionMetrics);
        fileOutput.writeRankedByCGPA(cgpaSorted, "ranked_by_cgpa.txt");
       
        // 2. Sort by Enrollment (using Merge Sort)
        cout << "\n2. Sorting by enrollment year (Merge Sort)..." << endl;
        Student* enrollmentSorted = sorter.copyList(sampleHead);
        enrollmentSorted = sorter.sortWithMerge(enrollmentSorted,
                                               SortingAlgorithms::compareByEnrollment,
                                               mergeMetrics1);
        fileOutput.writeSortedByEnrollment(enrollmentSorted, "sorted_by_enrollment.txt");
       
        // 3. Department Analysis (using Merge Sort)
        cout << "\n3. Analyzing by department (Merge Sort)..." << endl;
        Student* deptSorted = sorter.copyList(sampleHead);
        deptSorted = sorter.sortWithMerge(deptSorted,
                                         SortingAlgorithms::compareByDepartmentSemester,
                                         mergeMetrics2);
        fileOutput.writeDepartmentAnalysis(deptSorted, "department_analysis.txt");
       
        // 4. Performance Tiers
        cout << "\n4. Categorizing into performance tiers..." << endl;
        Student* tierSorted = sorter.copyList(sampleHead);
        tierSorted = sorter.sortWithSelection(tierSorted,
                                            SortingAlgorithms::compareByPerformanceTier,
                                            selectionMetrics);
        fileOutput.writePerformanceTiers(tierSorted, sampleSize, "performance_tiers.txt");
       
        // Write algorithm performance metrics
        fileOutput.writeAlgorithmMetrics(selectionMetrics, mergeMetrics1, "algorithm_performance.txt");
       
        // Bonus: Data validation and duplicate detection
        cout << "\n5. Performing data validation..." << endl;
        fileOutput.writeDataValidation(originalHead, "data_issues.txt");
        fileOutput.writeDuplicateReport(originalHead, "duplicates_report.txt");
       
        // Clean up
        deleteList(cgpaSorted);
        deleteList(enrollmentSorted);
        deleteList(deptSorted);
        deleteList(tierSorted);
       
        // Clean up sample if we created one
        if (totalStudents > 10000) {
            deleteList(sampleHead);
        }
       
        cout << "\n========================================" << endl;
        cout << "      ALL REPORTS GENERATED SUCCESSFULLY!" << endl;
        cout << "========================================" << endl;
    }
   
    // Search for student by ID
    void searchStudent(int studentID) {
        fileOutput.searchStudent(list.getHead(), studentID, "search_results.txt");
    }
};

